---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/PaperCard.astro';

const all = await getCollection('research');
const grouped = new Map<number, typeof all>();
for (const p of all) {
  const arr = grouped.get(p.data.year) ?? [];
  arr.push(p);
  grouped.set(p.data.year, arr);
}
const years = [...grouped.keys()].sort((a, b) => b - a);
for (const y of years) {
  grouped.get(y)!.sort((a, b) => a.data.order - b.data.order);
}
---

<BaseLayout title="Research" description="Selected papers and research notes.">
  <section class="research">
    <header class="page-head">
      <p class="eyebrow">Research</p>
      <h1>Papers &amp; preprints</h1>
      <p class="page-lede">A chronological list of recent work. Click PDF / arXiv / Code chips to access materials, or BibTeX to copy citation.</p>
    </header>

    {years.length === 0 && (
      <p class="empty-state">No papers yet. Add a <code>.md</code> file under <code>src/content/research/</code> with frontmatter (title, authors, venue, year).</p>
    )}

    {years.map((year) => (
      <div class="year-group">
        <h2 class="year-heading">{year}</h2>
        <div class="papers">
          {grouped.get(year)!.map((p) => (
            <PaperCard
              title={p.data.title}
              authors={p.data.authors}
              venue={p.data.venue}
              year={p.data.year}
              pdf={p.data.pdf}
              arxiv={p.data.arxiv}
              code={p.data.code}
              bibtex={p.data.bibtex}
              slug={p.id}
            />
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .page-head h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: var(--space-2) 0 var(--space-3);
    font-weight: 450;
    letter-spacing: -0.015em;
  }
  .page-lede {
    color: var(--color-text-soft);
    max-width: 60ch;
  }

  .year-group {
    margin-top: var(--space-6);
  }

  .year-heading {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .papers {
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
    font-size: 0.92rem;
  }
  .empty-state code {
    background: var(--color-bg-soft);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-tag-text);
  }
</style>
