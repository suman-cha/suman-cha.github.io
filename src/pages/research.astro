---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchIndex from '../components/ResearchIndex.astro';
import { researchPapers } from '../data/papers';
---

<BaseLayout title="Research" description="Five papers and preprints by Suman Cha, with full author lists and public links.">
  <section class="research-page" aria-labelledby="research-title">
    <header class="page-head">
      <h1 id="research-title">Research</h1>
    </header>

    <ResearchIndex papers={researchPapers} />
  </section>
</BaseLayout>

<style>
  /* Hallmark · macrostructure: Index-First · page: five-paper research ledger */
  .research-page {
    display: grid;
    gap: var(--space-2xl);
  }

  .page-head {
    padding-bottom: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-border);
  }
</style>
