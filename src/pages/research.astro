---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getKindLabel, getPaperUploads } from '../lib/uploads';

const scholarHref = 'https://scholar.google.co.kr/citations?user=U9j8rScAAAAJ&hl=ko';
const paperUploads = getPaperUploads();
---

<BaseLayout title="Research" description="Research papers and Google Scholar profile for Suman Cha.">
  <section class="research">
    <header class="page-head">
      <p class="eyebrow">Research</p>
      <h1>Papers live in Scholar first.</h1>
      <p class="page-lede">
        This page does not infer a publication list from local placeholder files.
        Use Google Scholar for the canonical paper list, and place PDFs, HTML previews, or Markdown notes under <code>public/uploads/papers/</code> when a local copy should appear here.
      </p>
    </header>

    <div class="scholar-panel">
      <div>
        <span class="panel-label">Canonical source</span>
        <h2>Google Scholar</h2>
        <p>Publication titles, citations, and arXiv links should be checked against the live Scholar profile rather than placeholder metadata in the repo.</p>
      </div>
      <a href={scholarHref} class="panel-link" target="_blank" rel="noopener noreferrer">Open Scholar</a>
    </div>

    <section class="uploaded-papers" aria-labelledby="uploaded-papers-heading">
      <header class="section-head">
        <p class="eyebrow">Uploaded papers</p>
        <h2 id="uploaded-papers-heading">Local paper files.</h2>
      </header>

      {paperUploads.length === 0 ? (
        <p class="empty-state">
          No paper files uploaded yet. Add files under <code>public/uploads/papers/</code>, then rebuild.
        </p>
      ) : (
        <ul class="paper-file-list">
          {paperUploads.map((entry) => (
            <li>
              <a href={entry.href}>
                <span>{getKindLabel(entry.kind)}</span>
                <strong>{entry.title}</strong>
                <em>{entry.extension}</em>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </section>
</BaseLayout>

<style>
  /* Hallmark · macrostructure: Editorial Source Index · theme: existing academic-minimal
   * Hallmark · pre-emit critique: P5 H4 E4 S5 R5 V4
   * source policy: uploaded files + Google Scholar only
   */

  .research {
    display: grid;
    gap: var(--space-8);
  }

  .page-head {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .page-head h1 {
    max-width: 12ch;
    font-size: clamp(2rem, 6vw, 4.2rem);
    margin: var(--space-2) 0 var(--space-3);
    font-weight: 450;
    line-height: 1.05;
  }

  .page-lede {
    color: var(--color-text-soft);
    max-width: 68ch;
    line-height: 1.7;
  }

  .page-lede code,
  .empty-state code {
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-soft);
    color: var(--color-tag-text);
    font-size: 0.86em;
  }

  .scholar-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-block: 1px solid var(--color-border);
  }

  .panel-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .scholar-panel h2 {
    margin: var(--space-2) 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 450;
  }

  .scholar-panel p {
    max-width: 64ch;
    color: var(--color-text-soft);
  }

  .panel-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    min-height: 36px;
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-soft);
    background: var(--color-bg);
    font-size: 0.86rem;
    line-height: 1;
    white-space: nowrap;
    transition: border-color var(--transition), color var(--transition), background-color var(--transition);
  }

  .panel-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-soft);
  }

  .panel-link:active {
    background: var(--color-accent-soft);
  }

  .uploaded-papers {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-head {
    display: grid;
    gap: var(--space-2);
  }

  .section-head h2 {
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 450;
  }

  .paper-file-list {
    display: grid;
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .paper-file-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .paper-file-list a {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
    color: var(--color-text-soft);
    transition: color var(--transition);
  }

  .paper-file-list a:hover {
    color: var(--color-accent);
  }

  .paper-file-list a:active {
    color: var(--color-accent-hover);
  }

  .paper-file-list span,
  .paper-file-list em {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }

  .paper-file-list strong {
    min-width: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .paper-file-list em {
    font-style: normal;
  }

  .empty-state {
    padding: var(--space-5);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  @media (min-width: 42rem) {
    .scholar-panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  @media (max-width: 30rem) {
    .paper-file-list a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>
