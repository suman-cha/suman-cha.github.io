---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Projects" description="Research projects by Suman Cha.">
  <section class="projects-index">
    <header class="archive-hero">
      <p class="eyebrow">Projects</p>
      <h1>Research systems and project notes.</h1>
      <p class="page-lede">
        A compact public index for collaborators who need the current project map and a quick sense of the work.
      </p>
    </header>

    {projects.length === 0 ? (
      <p class="empty-state">No public projects listed yet.</p>
    ) : (
      <div class="project-ledger">
        {projects.map((project) => (
          <article class="project-row">
            <div class="project-time">
              <span>{project.data.period}</span>
              {project.data.status && <em>{project.data.status}</em>}
            </div>

            <div class="project-body">
              <h2>{project.data.title}</h2>
              <p>{project.data.tagline}</p>

              {project.data.topics.length > 0 && (
                <ul class="topic-list" aria-label={`${project.data.title} topics`}>
                  {project.data.topics.map((topic) => (
                    <li>{topic}</li>
                  ))}
                </ul>
              )}

              {project.data.links.length > 0 && (
                <div class="external-links" aria-label={`${project.data.title} external links`}>
                  {project.data.links.map((link) => (
                    <a href={link.href} class="external-link" target="_blank" rel="noopener noreferrer">{link.label}</a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  /* Hallmark · macrostructure: Editorial Index · theme: existing academic-minimal
   * Hallmark · pre-emit critique: P5 H4 E4 S5 R5 V4
   * contrast: pass (46–50) · chrome: pass (57) · tokens: pass (58)
   */

  .projects-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .archive-hero {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .archive-hero h1 {
    max-width: 12ch;
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 450;
    line-height: 1.04;
  }

  .page-lede {
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-soft);
  }

  .project-ledger {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-time {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .project-time em {
    font-style: normal;
    color: var(--color-text-soft);
  }

  .project-body {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .project-body h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    font-weight: 450;
    line-height: 1.12;
  }

  .project-body p {
    max-width: 68ch;
    color: var(--color-text-soft);
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-1) 0 0;
    list-style: none;
  }

  .topic-list li {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .topic-list li::before {
    content: "/";
    margin-right: var(--space-2);
    color: var(--color-border-strong);
  }

  .external-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 34px;
    padding: 4px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-soft);
    background: var(--color-bg);
    font-size: 0.82rem;
    line-height: 1;
    white-space: nowrap;
    transition: border-color var(--transition), color var(--transition), background-color var(--transition);
  }

  .external-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-soft);
  }

  .external-link:active {
    background: var(--color-accent-soft);
  }

  .empty-state {
    padding: var(--space-5);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 46rem) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-row {
      gap: var(--space-3);
    }

    .project-time {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
    }

    .external-link {
      max-width: 100%;
    }
  }

  @media (max-width: 24rem) {
    .archive-hero h1 {
      font-size: clamp(1.85rem, 14vw, 2.4rem);
    }

  }
</style>
