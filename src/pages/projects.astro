---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getKindLabel, getUploads, groupUploadsByKind, type UploadKind } from '../lib/uploads';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const uploads = getUploads();
const uploadsByKind = groupUploadsByKind(uploads);
const kindOrder: UploadKind[] = ['pdf', 'html', 'markdown', 'data', 'code', 'image', 'archive', 'file'];
const materialKinds = kindOrder.filter((kind) => uploadsByKind[kind]?.length);

const projectsWithUploads = projects.map((project) => {
  const slug = project.id.replace(/\.md$/, '');
  return {
    ...project,
    slug,
    uploads: uploads.filter((entry) => entry.projectSlug === slug),
  };
});

const generalUploads = uploads.filter((entry) => entry.projectSlug === null);
---

<BaseLayout title="Projects" description="Research projects and working materials from Suman Cha.">
  <section class="projects-index">
    <header class="archive-hero">
      <p class="eyebrow">Projects</p>
      <h1>Research systems, papers, and working materials.</h1>
      <p class="page-lede">
        A compact index for collaborators who need the current project map and the files attached to it.
        Drop a PDF, HTML page, Markdown note, dataset, or code file into <code>public/uploads/</code>, then rebuild.
      </p>
    </header>

    <div class="archive-meta" aria-label="Upload conventions">
      <div>
        <span class="meta-label">Attach to project</span>
        <code>public/uploads/project-slug/file.pdf</code>
      </div>
      <div>
        <span class="meta-label">General material</span>
        <code>public/uploads/_general/file.md</code>
      </div>
    </div>

    {projectsWithUploads.length === 0 ? (
      <p class="empty-state">No projects yet. Add a <code>.md</code> file under <code>src/content/projects/</code> with frontmatter.</p>
    ) : (
      <div class="project-ledger">
        {projectsWithUploads.map((project) => (
          <article class="project-row">
            <div class="project-time">
              <span>{project.data.period}</span>
              {project.data.status && <em>{project.data.status}</em>}
            </div>

            <div class="project-body">
              <h2>{project.data.title}</h2>
              <p>{project.data.tagline}</p>

              {project.data.topics.length > 0 && (
                <ul class="topic-list" aria-label={`${project.data.title} topics`}>
                  {project.data.topics.map((topic) => (
                    <li>{topic}</li>
                  ))}
                </ul>
              )}

              <div class="material-strip" aria-label={`${project.data.title} materials`}>
                {project.uploads.length === 0 ? (
                  <span class="no-materials">No files attached yet</span>
                ) : (
                  project.uploads.map((entry) => (
                    <a href={entry.href} class="material-link">
                      <span>{getKindLabel(entry.kind)}</span>
                      {entry.title}
                    </a>
                  ))
                )}
              </div>

              {project.data.links.length > 0 && (
                <div class="external-links" aria-label={`${project.data.title} external links`}>
                  {project.data.links.map((link) => (
                    <a href={link.href} class="external-link" target="_blank" rel="noopener noreferrer">{link.label}</a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <section class="materials-index" aria-labelledby="materials-heading">
      <header class="materials-head">
        <p class="eyebrow">All materials</p>
        <h2 id="materials-heading">Files published with this portfolio.</h2>
      </header>

      {uploads.length === 0 ? (
        <p class="empty-state">
          Add files under <code>public/uploads/</code>. Hidden files are ignored, and folders become project attachments.
        </p>
      ) : (
        <div class="materials-grid">
          {materialKinds.map((kind) => (
            <section class="material-group" aria-labelledby={`material-${kind}`}>
              <h3 id={`material-${kind}`}>{getKindLabel(kind)}</h3>
              <ul>
                {uploadsByKind[kind].map((entry) => (
                  <li>
                    <a href={entry.href}>
                      <span>{entry.title}</span>
                      <em>{entry.projectSlug ?? 'general'}</em>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}

      {generalUploads.length > 0 && (
        <div class="general-note">
          <span>General</span>
          <p>{generalUploads.length} file{generalUploads.length === 1 ? '' : 's'} not tied to a project slug.</p>
        </div>
      )}
    </section>
  </section>
</BaseLayout>

<style>
  /* Hallmark · macrostructure: Editorial Index · theme: existing academic-minimal
   * Hallmark · pre-emit critique: P5 H4 E4 S5 R5 V4
   * contrast: pass (46–50) · chrome: pass (57) · tokens: pass (58)
   */

  .projects-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .archive-hero {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .archive-hero h1 {
    max-width: 12ch;
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 450;
    line-height: 1.04;
  }

  .page-lede {
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-soft);
  }

  .page-lede code,
  .archive-meta code,
  .empty-state code {
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-soft);
    color: var(--color-tag-text);
    font-size: 0.86em;
  }

  .archive-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-block: 1px solid var(--color-border);
  }

  .archive-meta > div {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .archive-meta > div:last-child {
    border-bottom: 0;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-ledger {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-time {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .project-time em {
    font-style: normal;
    color: var(--color-text-soft);
  }

  .project-body {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .project-body h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    font-weight: 450;
    line-height: 1.12;
  }

  .project-body p {
    max-width: 68ch;
    color: var(--color-text-soft);
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-1) 0 0;
    list-style: none;
  }

  .topic-list li {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .topic-list li::before {
    content: "/";
    margin-right: var(--space-2);
    color: var(--color-border-strong);
  }

  .material-strip,
  .external-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .material-link,
  .external-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 34px;
    padding: 4px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-soft);
    background: var(--color-bg);
    font-size: 0.82rem;
    line-height: 1;
    white-space: nowrap;
    transition: border-color var(--transition), color var(--transition), background-color var(--transition);
  }

  .material-link:hover,
  .external-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-soft);
  }

  .material-link:active,
  .external-link:active {
    background: var(--color-accent-soft);
  }

  .material-link span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  .no-materials {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .materials-index {
    display: grid;
    gap: var(--space-5);
  }

  .materials-head {
    display: grid;
    gap: var(--space-2);
  }

  .materials-head h2 {
    max-width: 16ch;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 450;
  }

  .materials-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
  }

  .material-group {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .material-group h3 {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .material-group ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .material-group a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-text-soft);
    font-size: 0.9rem;
    transition: color var(--transition);
  }

  .material-group a:hover {
    color: var(--color-accent);
  }

  .material-group span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .material-group em {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
    color: var(--color-text-muted);
  }

  .general-note {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .general-note span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .general-note p {
    margin: 0;
    font-size: 0.88rem;
  }

  .empty-state {
    padding: var(--space-5);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  @media (min-width: 40rem) {
    .archive-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .archive-meta > div {
      padding: var(--space-4);
      border-right: 1px solid var(--color-border);
      border-bottom: 0;
    }

    .archive-meta > div:first-child {
      padding-left: 0;
    }

    .archive-meta > div:last-child {
      border-right: 0;
    }
  }

  @media (max-width: 46rem) {
    .project-row,
    .materials-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-row {
      gap: var(--space-3);
    }

    .project-time {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
    }

    .material-link,
    .external-link {
      max-width: 100%;
    }

    .material-group {
      padding-right: 0;
    }
  }

  @media (max-width: 24rem) {
    .archive-hero h1 {
      font-size: clamp(1.85rem, 14vw, 2.4rem);
    }

    .material-group a,
    .general-note {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
