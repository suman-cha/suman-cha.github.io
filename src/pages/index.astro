---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchIndex from '../components/ResearchIndex.astro';
import { papersUnderReview, publishedPapers } from '../data/papers';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Suman Cha',
  url: 'https://suman-cha.github.io',
  email: 'mailto:oldrain123@yonsei.ac.kr',
  jobTitle: 'Integrated M.S./Ph.D. Student',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Yonsei University',
    department: 'Statistics and Data Science',
  },
  sameAs: [
    'https://github.com/suman-cha',
    'https://scholar.google.co.kr/citations?user=U9j8rScAAAAJ',
  ],
};
---

<BaseLayout
  description="Research and public code by Suman Cha, an integrated M.S./Ph.D. student at Yonsei University."
  jsonLd={jsonLd}
>
  <div class="home-index">
    <section class="index-section" aria-labelledby="published-heading">
      <header class="section-head">
        <h2 id="published-heading">Publications</h2>
        <a href="/research">All research <span aria-hidden="true">→</span></a>
      </header>
      <ResearchIndex papers={publishedPapers} compact />
    </section>

    <section class="index-section" aria-labelledby="review-heading">
      <header class="section-head">
        <h2 id="review-heading">Under review</h2>
      </header>
      <ResearchIndex papers={papersUnderReview} compact />
    </section>
  </div>
</BaseLayout>

<style>
  /* Hallmark · macrostructure: Long Document · home: the publication record, venue first */
  .home-index {
    display: grid;
    gap: var(--space-2xl);
  }

  .index-section {
    display: grid;
    gap: var(--space-md);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
  }

  .section-head h2 {
    font-size: var(--text-lg);
  }

  .section-head a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: var(--rule-underline-offset);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .section-head a:hover {
      color: var(--color-accent-hover);
      text-decoration-color: currentColor;
    }
  }
</style>
