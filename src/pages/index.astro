---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import ResearchIndex from '../components/ResearchIndex.astro';
import { researchPapers } from '../data/papers';
import { publicProjects } from '../data/projects';
---

<BaseLayout description="Research and public code by Suman Cha, an integrated M.S./Ph.D. student at Yonsei University.">
  <div class="home-index">
    <section class="introduction" aria-labelledby="home-title">
      <h1 id="home-title">Statistics, testing, and learning.</h1>
      <p>
        Research in statistical inference and testing, imbalanced classification,
        mixed-type tabular generative modeling, and statistical machine learning.
      </p>
    </section>

    <section class="index-section" aria-labelledby="research-heading">
      <header class="section-head">
        <div>
          <h2 id="research-heading">Research</h2>
          <p>Five papers and current submissions.</p>
        </div>
        <a href="/research">All research <span aria-hidden="true">→</span></a>
      </header>
      <ResearchIndex papers={researchPapers} compact />
    </section>

    <section class="index-section" aria-labelledby="projects-heading">
      <header class="section-head">
        <div>
          <h2 id="projects-heading">Projects</h2>
          <p>Four public research codebases.</p>
        </div>
        <a href="/projects">All projects <span aria-hidden="true">→</span></a>
      </header>
      <ProjectIndex projects={publicProjects} compact />
    </section>
  </div>
</BaseLayout>

<style>
  /* Hallmark · macrostructure: Index-First · home: introduction + two complete indexes */
  .home-index {
    display: grid;
    gap: var(--space-3xl);
  }

  .introduction {
    display: grid;
    gap: var(--space-md);
    padding-bottom: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-border);
  }

  .introduction h1 {
    max-width: 17ch;
  }

  .introduction p {
    max-width: 66ch;
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  .index-section {
    display: grid;
    gap: var(--space-lg);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }

  .section-head div {
    display: grid;
    gap: var(--space-2xs);
  }

  .section-head p {
    font-size: var(--text-sm);
  }

  .section-head a {
    justify-self: start;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: var(--rule-underline-offset);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .section-head a:hover {
      color: var(--color-accent-hover);
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 40rem) {
    .section-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .section-head a {
      justify-self: end;
    }
  }
</style>
