---
import BaseLayout from '../layouts/BaseLayout.astro';
import { scholarPapers } from '../data/papers';

const selectedPapers = scholarPapers;
---

<BaseLayout>
  <section class="welcome">
    <p class="eyebrow">Welcome</p>
    <h1>Hi, I&rsquo;m Suman.</h1>
    <p class="lede">
      This is a quiet corner of the web for my work in statistics and machine learning.
      Here you&rsquo;ll find my papers, preprints, and current submissions.
    </p>
  </section>

  <section class="research-preview">
    <div class="col-head">
      <p class="eyebrow">Research</p>
      <a href="/research" class="see-all">View details &rarr;</a>
    </div>
    <ul class="mini-list">
      {selectedPapers.map((paper) => (
        <li class="mini-item">
          <a href="/research" class="mini-link">
            <span class="mini-title">{paper.title}</span>
            <span class="mini-meta">{paper.year} · {paper.status ?? paper.venue}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .welcome {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }
  .welcome h1 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 450;
    letter-spacing: -0.015em;
  }
  .lede {
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 60ch;
    color: var(--color-text-soft);
  }
  .lede code {
    background: var(--color-bg-soft);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--color-tag-text);
  }

  .research-preview {
    max-width: 52rem;
  }

  .col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .see-all {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: color var(--transition);
  }
  .see-all:hover { color: var(--color-accent-hover); }

  .mini-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mini-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 0;
    border-bottom: 1px dashed transparent;
    transition: border-color var(--transition);
  }
  .mini-link:hover { border-bottom-color: var(--color-border); }
  .mini-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.35;
    color: var(--color-text);
  }
  .mini-meta {
    font-size: 0.76rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
</style>
