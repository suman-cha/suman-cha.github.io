---
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import sansFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'Research and open-source projects by Suman Cha, a statistics and data science researcher at Yonsei University.',
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} — Suman Cha` : 'Suman Cha';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f5f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <title>{fullTitle}</title>

    <!-- Theme bootstrap (must run before paint to avoid flash) -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main class="site-main" id="main">
      <div class="layout-shell">
        <Sidebar full={Astro.url.pathname === '/'} />
        <div class="content">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Hallmark · macrostructure: Long Document · shell: asymmetric profile/content */
  .site-main {
    min-height: calc(100dvh - var(--header-height));
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .layout-shell {
    width: 100%;
    max-width: var(--content-width-wide);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .content {
    min-width: 0;
  }

  @media (min-width: 56rem) {
    .layout-shell {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
      column-gap: clamp(var(--space-xl), 6vw, var(--space-3xl));
    }
  }
</style>
