---
interface Props {
  layout?: 'horizontal' | 'vertical';
}

const { layout = 'horizontal' } = Astro.props;
const links = [
  { label: 'Email', href: 'mailto:oldrain123@yonsei.ac.kr', external: false },
  { label: 'GitHub', href: 'https://github.com/suman-cha', external: true },
  {
    label: 'Google Scholar',
    href: 'https://scholar.google.co.kr/citations?user=U9j8rScAAAAJ&hl=en',
    external: true,
  },
];
---

<ul class:list={['social', `social-${layout}`]}>
  {links.map(({ label, href, external }) => (
    <li>
      <a
        href={href}
        class="social-link"
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
      >
        <span>{label}</span>
        {external && <span aria-hidden="true">↗</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  /* Hallmark · social links: plain-text index */
  .social {
    display: flex;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .social-horizontal {
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .social-vertical {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3xs);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2rem;
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: var(--rule-underline-offset);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }
  }
</style>
