---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
const links = [
  { href: '/research', label: 'Research' },
  { href: '/projects', label: 'Projects' },
  { href: '/CV.pdf', label: 'CV' },
];

const isActive = (href: string) => href !== '/CV.pdf' && pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Home">Home</a>

    <div class="header-right">
      <nav aria-label="Primary">
        <ul class="nav-list">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={['nav-link', { 'is-active': isActive(href) }]}
                aria-current={isActive(href) ? 'page' : undefined}
                target={href === '/CV.pdf' ? '_blank' : undefined}
                rel={href === '/CV.pdf' ? 'noopener' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Hallmark · nav: N1 Wordmark + destination links · knobs: split, text, sticky */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: var(--rule-hair) solid var(--color-border);
    background: var(--color-bg);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--content-width-wide);
    height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
    gap: var(--space-xs);
  }

  .brand {
    color: var(--color-text);
    font-family: var(--font-wordmark);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    white-space: nowrap;
  }

  .header-right,
  .nav-list {
    display: flex;
    align-items: center;
  }

  .header-right {
    gap: var(--space-2xs);
  }

  .nav-list {
    gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2xs);
    border-bottom: var(--rule-hair) solid transparent;
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-link.is-active {
    border-bottom-color: var(--color-accent);
    color: var(--color-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover,
    .nav-link:hover {
      color: var(--color-accent);
    }
  }

  @media (min-width: 40rem) {
    .header-right {
      gap: var(--space-xs);
    }

    .nav-list {
      gap: var(--space-sm);
    }

    .nav-link {
      padding-inline: var(--space-xs);
      font-size: var(--text-sm);
    }
  }
</style>
