---
import AuthorList from './AuthorList.astro';
import PowerFigure from './PowerFigure.astro';
import type { ResearchPaper } from '../data/papers';
import { paperThumbnails } from '../data/thumbnails';

interface Props {
  papers: ResearchPaper[];
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { papers, compact = false, headingLevel = 'h2' } = Astro.props;
const Title = headingLevel;
const isExternal = (href: string) => href.startsWith('http://') || href.startsWith('https://');
const publicationLabel = (paper: ResearchPaper) =>
  paper.status?.startsWith('Submitted to ') || paper.status?.startsWith('Accepted at ')
    ? paper.status
    : paper.venue;
---

<ol class:list={['research-index', { 'is-compact': compact }]}>
  {papers.map((paper) => compact ? (
    <li class="compact-row">
      <a class="compact-link" href={`/research#${paper.id}`}>
        <span class="compact-title">{paper.title}</span>
        <span class="compact-meta">
          <span>{publicationLabel(paper)}</span>
          <time datetime={String(paper.year)}>{paper.year}</time>
        </span>
      </a>
    </li>
  ) : (
    <li class="paper-row" id={paper.id}>
      <article class="paper-body">
        <header class="paper-heading">
          <p class="paper-meta">
            <span>{publicationLabel(paper)}</span>
            <time datetime={String(paper.year)}>{paper.year}</time>
          </p>
          <Title>{paper.title}</Title>
        </header>

        <AuthorList authors={paper.authors} notes={paper.authorNotes} />

        {paper.links.length > 0 && (
          <nav class="paper-links" aria-label={`Links for ${paper.title}`}>
            {paper.links.map((link) => (
              <a
                href={link.href}
                target={isExternal(link.href) ? '_blank' : undefined}
                rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
              >
                {link.label}{isExternal(link.href) && <span aria-hidden="true"> ↗</span>}
              </a>
            ))}
          </nav>
        )}
      </article>

      {paper.id === 'mc-perm-power' ? (
        <div class="paper-thumb">
          <PowerFigure />
        </div>
      ) : paperThumbnails[paper.id] && (
        <a class="paper-thumb" href={paperThumbnails[paper.id].full} target="_blank" rel="noopener">
          <img
            src={paperThumbnails[paper.id].src}
            width={paperThumbnails[paper.id].width}
            height={paperThumbnails[paper.id].height}
            alt={paperThumbnails[paper.id].alt}
            loading="lazy"
            decoding="async"
          />
          <span class="visually-hidden">(full-size figure, opens in a new tab)</span>
        </a>
      )}
    </li>
  ))}
</ol>

<style>
  /* Hallmark · macrostructure: Long Document · content: research ledger, venue first */
  .research-index {
    padding: 0;
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-border);
    list-style: none;
  }

  .paper-row,
  .compact-row {
    border-bottom: var(--rule-hair) solid var(--color-border);
  }

  .paper-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem;
    align-items: start;
    gap: var(--space-md);
    padding-block: var(--space-lg) var(--space-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .paper-thumb {
    display: grid;
    place-items: center;
    width: 100%;
    margin-top: var(--space-lg);
    aspect-ratio: 3 / 2;
    padding: var(--space-2xs);
    border: var(--rule-hair) solid var(--color-border);
    background: var(--color-figure-paper);
    transition: border-color var(--dur-micro) ease;
  }

  .paper-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .paper-body,
  .paper-heading {
    display: grid;
    min-width: 0;
  }

  .paper-body {
    gap: var(--space-md);
  }

  .paper-heading {
    gap: var(--space-xs);
  }

  .paper-meta,
  .compact-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .paper-meta span {
    color: var(--color-accent);
    font-weight: 600;
  }

  .paper-meta time,
  .compact-meta time {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .paper-body :is(h2, h3) {
    font-size: clamp(var(--text-md), 3vw, var(--text-lg));
    line-height: var(--leading-snug);
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }

  .paper-links a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: var(--rule-underline-offset);
    white-space: nowrap;
  }

  .compact-link {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-md);
  }

  .compact-title {
    min-width: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
    text-wrap: balance;
    transition: color var(--dur-micro) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    a.paper-thumb:hover {
      border-color: var(--color-accent);
    }

    .paper-links a:hover,
    .compact-link:hover .compact-title {
      color: var(--color-accent-hover);
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 40rem) {
    .paper-row {
      grid-template-columns: minmax(0, 1fr) 11rem;
      gap: var(--space-xl);
    }

    .compact-title {
      font-size: var(--text-md);
    }
  }
</style>
