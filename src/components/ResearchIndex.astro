---
import AuthorList from './AuthorList.astro';
import type { ResearchPaper } from '../data/papers';

interface Props {
  papers: ResearchPaper[];
  compact?: boolean;
}

const { papers, compact = false } = Astro.props;
const number = (index: number) => String(index + 1).padStart(2, '0');
const isExternal = (href: string) => href.startsWith('http://') || href.startsWith('https://');
const publicationLabel = (paper: ResearchPaper) =>
  paper.status?.startsWith('Submitted to ') ? paper.status : paper.venue;
---

<ol class:list={['research-index', { 'is-compact': compact }]}>
  {papers.map((paper, index) => compact ? (
    <li class="compact-row">
      <a class="compact-link" href={`/research#${paper.id}`}>
        <span class="index-number" aria-hidden="true">{number(index)}</span>
        <span class="compact-title">{paper.title}</span>
        <time datetime={String(paper.year)}>{paper.year}</time>
      </a>
    </li>
  ) : (
    <li class="paper-row" id={paper.id}>
      <div class="row-register" aria-label={`Entry ${index + 1}, ${paper.year}`}>
        <span aria-hidden="true">{number(index)}</span>
        <time datetime={String(paper.year)}>{paper.year}</time>
      </div>

      <article class="paper-body">
        <header class="paper-heading">
          <p class="paper-meta">{publicationLabel(paper)}</p>
          <h2>{paper.title}</h2>
        </header>

        <AuthorList authors={paper.authors} notes={paper.authorNotes} />

        {paper.links.length > 0 && (
          <nav class="paper-links" aria-label={`Links for ${paper.title}`}>
            {paper.links.map((link) => (
              <a
                href={link.href}
                target={isExternal(link.href) ? '_blank' : undefined}
                rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
              >
                {link.label}{isExternal(link.href) && <span aria-hidden="true"> ↗</span>}
              </a>
            ))}
          </nav>
        )}
      </article>
    </li>
  ))}
</ol>

<style>
  /* Hallmark · macrostructure: Index-First · content: research ledger */
  .research-index {
    padding: 0;
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-border);
    list-style: none;
  }

  .paper-row,
  .compact-row {
    border-bottom: var(--rule-hair) solid var(--color-border);
  }

  .paper-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-lg) var(--space-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .row-register {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-label);
  }

  .paper-body,
  .paper-heading {
    display: grid;
    min-width: 0;
  }

  .paper-body {
    gap: var(--space-md);
  }

  .paper-heading {
    gap: var(--space-xs);
  }

  .paper-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .paper-body h2 {
    font-size: clamp(var(--text-md), 3vw, var(--text-lg));
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }

  .paper-links a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: var(--rule-underline-offset);
    white-space: nowrap;
  }

  .compact-link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-xs);
    padding-block: var(--space-sm);
  }

  .index-number,
  .compact-link time {
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-label);
  }

  .compact-title {
    min-width: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    .paper-links a:hover,
    .compact-link:hover .compact-title {
      color: var(--color-accent-hover);
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 40rem) {
    .paper-row {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .row-register {
      flex-direction: column;
      justify-content: flex-start;
      gap: var(--space-xs);
      padding-top: var(--space-3xs);
    }

    .compact-link {
      grid-template-columns: 2.5rem minmax(0, 1fr) 4rem;
      gap: var(--space-md);
    }

    .compact-title {
      font-size: var(--text-md);
    }

    .compact-link time {
      justify-self: end;
    }
  }
</style>
