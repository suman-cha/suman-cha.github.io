---
import type { PublicProject } from '../data/projects';

interface Props {
  projects: PublicProject[];
  compact?: boolean;
}

const { projects, compact = false } = Astro.props;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<ol class:list={['project-index', { 'is-compact': compact }]}>
  {projects.map((project, index) => compact ? (
    <li class="compact-row">
      <a class="compact-link" href={`/projects#${project.id}`}>
        <span class="index-number" aria-hidden="true">{number(index)}</span>
        <span class="compact-copy">
          <span class="compact-title">{project.name}</span>
          <span class="compact-meta">{project.languages.join(' · ')}</span>
        </span>
      </a>
    </li>
  ) : (
    <li class="project-row" id={project.id}>
      <div class="row-register" aria-label={`Entry ${index + 1}`}>
        <span aria-hidden="true">{number(index)}</span>
      </div>

      <article class="project-body">
        <header class="project-heading">
          <p>{project.languages.join(' · ')}</p>
          <h2>{project.name}</h2>
        </header>

        <p class="project-summary">{project.summary}</p>

        <ul class="project-contributions" aria-label={`${project.name} contributions`}>
          {project.contributions.map((contribution) => <li>{contribution}</li>)}
        </ul>

        <nav class="project-links" aria-label={`Links for ${project.name}`}>
          <a href={project.repository} target="_blank" rel="noopener noreferrer">
            {project.repositoryLabel} <span aria-hidden="true">↗</span>
          </a>
          {project.relatedPublicationId && (
            <a href={`/research#${project.relatedPublicationId}`}>Related paper <span aria-hidden="true">→</span></a>
          )}
        </nav>
      </article>
    </li>
  ))}
</ol>

<style>
  /* Hallmark · macrostructure: Index-First · content: public project ledger */
  .project-index {
    padding: 0;
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-border);
    list-style: none;
  }

  .project-row,
  .compact-row {
    border-bottom: var(--rule-hair) solid var(--color-border);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-lg) var(--space-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .row-register,
  .index-number,
  .compact-meta,
  .project-heading p {
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-label);
  }

  .project-body,
  .project-heading {
    display: grid;
    min-width: 0;
  }

  .project-body {
    gap: var(--space-md);
  }

  .project-heading {
    gap: var(--space-xs);
  }

  .project-body h2 {
    font-size: clamp(var(--text-lg), 4vw, var(--text-xl));
  }

  .project-summary {
    max-width: 68ch;
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }

  .project-contributions {
    display: grid;
    max-width: 68ch;
    padding: 0;
    gap: var(--space-xs);
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    list-style: none;
  }

  .project-contributions li {
    display: grid;
    grid-template-columns: var(--space-sm) minmax(0, 1fr);
    gap: var(--space-xs);
  }

  .project-contributions li::before {
    content: "—";
    color: var(--color-text-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }

  .project-links a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: var(--rule-underline-offset);
    white-space: nowrap;
  }

  .compact-link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-xs);
    padding-block: var(--space-sm);
  }

  .compact-copy {
    display: grid;
    min-width: 0;
    gap: var(--space-3xs);
  }

  .compact-title {
    min-width: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-links a:hover,
    .compact-link:hover .compact-title {
      color: var(--color-accent-hover);
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 40rem) {
    .project-row {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .row-register {
      padding-top: var(--space-3xs);
    }

    .compact-link {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-md);
    }

    .compact-title {
      font-size: var(--text-md);
    }
  }
</style>
