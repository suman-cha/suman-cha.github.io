---
import type { PublicProject } from '../data/projects';

interface Props {
  projects: PublicProject[];
}

const { projects } = Astro.props;
---

<ul class="project-index">
  {projects.map((project) => (
    <li class="project-row" id={project.id}>
      <article class="project-body">
        <header class="project-heading">
          <p>{project.languages.join(', ')}</p>
          <h2>{project.name}</h2>
        </header>

        <p class="project-summary">{project.summary}</p>

        <ul class="project-contributions" aria-label={`${project.name} contributions`}>
          {project.contributions.map((contribution) => <li>{contribution}</li>)}
        </ul>

        <nav class="project-links" aria-label={`Links for ${project.name}`}>
          <a href={project.repository} target="_blank" rel="noopener noreferrer">
            {project.repositoryLabel} <span aria-hidden="true">↗</span>
          </a>
          {project.relatedPublicationId && (
            <a href={`/research#${project.relatedPublicationId}`}>Related paper</a>
          )}
        </nav>
      </article>
    </li>
  ))}
</ul>

<style>
  /* Hallmark · macrostructure: Long Document · content: public project ledger */
  .project-index {
    padding: 0;
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-border);
    list-style: none;
  }

  .project-row {
    border-bottom: var(--rule-hair) solid var(--color-border);
    padding-block: var(--space-lg) var(--space-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .project-heading p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .project-body,
  .project-heading {
    display: grid;
    min-width: 0;
  }

  .project-body {
    gap: var(--space-md);
  }

  .project-heading {
    gap: var(--space-xs);
  }

  .project-body h2 {
    font-size: clamp(var(--text-lg), 4vw, var(--text-xl));
  }

  .project-summary {
    width: 100%;
    max-width: 75ch;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .project-contributions {
    display: grid;
    width: 100%;
    max-width: 75ch;
    padding-inline-start: var(--space-md);
    gap: var(--space-xs);
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .project-contributions li {
    min-width: 0;
    padding-inline-start: var(--space-2xs);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .project-contributions li::marker {
    color: var(--color-text-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }

  .project-links a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: var(--rule-underline-offset);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-links a:hover {
      color: var(--color-accent-hover);
      text-decoration-color: currentColor;
    }
  }
</style>
