---
interface Props {
  title: string;
  authors: string;
  venue: string;
  year: number;
  pdf?: string;
  arxiv?: string;
  code?: string;
  bibtex?: string;
  slug: string;
}

const { title, authors, venue, year, pdf, arxiv, code, bibtex, slug } = Astro.props;
const bibtexId = `bib-${slug}`;
---

<article class="paper">
  <div class="paper-meta">
    <span class="paper-year">{year}</span>
    <span class="paper-venue">{venue}</span>
  </div>

  <h3 class="paper-title">{title}</h3>
  <p class="paper-authors">{authors}</p>

  <div class="paper-actions">
    {pdf && (
      <a href={pdf} class="chip" target="_blank" rel="noopener noreferrer">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        PDF
      </a>
    )}
    {arxiv && (
      <a href={arxiv} class="chip" target="_blank" rel="noopener noreferrer">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        arXiv
      </a>
    )}
    {code && (
      <a href={code} class="chip" target="_blank" rel="noopener noreferrer">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        Code
      </a>
    )}
    {bibtex && (
      <button class="chip bib-toggle" type="button" data-target={bibtexId} aria-expanded="false">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        BibTeX
      </button>
    )}
  </div>

  {bibtex && (
    <div class="bib-block" id={bibtexId} hidden>
      <pre><code>{bibtex}</code></pre>
      <button class="bib-copy chip" type="button" data-bib={bibtexId}>Copy</button>
    </div>
  )}
</article>

<style>
  .paper {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .paper:last-child { border-bottom: none; }

  .paper-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .paper-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .paper-venue {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .paper-title {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 2px 0 6px;
    letter-spacing: -0.005em;
  }

  .paper-authors {
    font-size: 0.88rem;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-3);
  }

  .paper-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .bib-block {
    margin-top: var(--space-3);
    padding: var(--space-3);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    position: relative;
  }
  .bib-block pre {
    margin: 0;
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-text-soft);
  }
  .bib-copy {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 0.72rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.bib-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.target!;
      const block = document.getElementById(id);
      if (!block) return;
      const open = !block.hasAttribute('hidden');
      if (open) {
        block.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        block.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.bib-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.bib!;
      const block = document.getElementById(id);
      const code = block?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        const orig = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = orig; }, 1400);
      } catch {}
    });
  });
</script>
