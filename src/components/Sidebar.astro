---
import SocialLinks from './SocialLinks.astro';
---

<aside class="sidebar" aria-label="Profile">
  <div class="sidebar-inner">
    <div class="identity">
      <p class="name">Suman Cha</p>
      <p class="role">Integrated M.S./Ph.D. Student</p>
      <p class="affiliation">Statistics and Data Science<br />Yonsei University</p>
    </div>

    <p class="bio">
      I work on statistical inference and testing, imbalanced classification,
      mixed-type tabular generative modeling, and statistical machine learning.
    </p>

    <p class="advisors">
      <span>Co-advised by</span>
      Prof. Hyunjoong Kim<br />
      Prof. Ilmun Kim
    </p>

    <SocialLinks layout="vertical" />
  </div>
</aside>

<style>
  /* Hallmark · profile: typographic rail · no imagery, cards, or shadow */
  .sidebar {
    padding-bottom: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-border);
  }

  .sidebar-inner {
    display: grid;
    gap: var(--space-lg);
    max-width: 34rem;
  }

  .identity {
    display: grid;
    gap: var(--space-2xs);
  }

  .name {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .role {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .affiliation,
  .bio,
  .advisors {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .bio {
    max-width: 32rem;
  }

  .advisors {
    padding-top: var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-border);
    color: var(--color-text-soft);
  }

  .advisors span {
    display: block;
    margin-bottom: var(--space-2xs);
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  @media (min-width: 56rem) {
    .sidebar {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
      padding-bottom: 0;
      border-bottom: 0;
    }

    .sidebar-inner {
      max-width: none;
    }
  }
</style>
