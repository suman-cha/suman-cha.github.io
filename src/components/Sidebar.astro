---
import SocialLinks from './SocialLinks.astro';
---

<aside class="sidebar" aria-label="Profile">
  <div class="sidebar-inner">
    <div class="photo-frame">
      <div class="photo-placeholder">
        <span>SC</span>
      </div>
      <!-- Replace the placeholder with: <img src="/me.jpg" alt="Profile photo" /> -->
    </div>

    <h1 class="name">Suman Cha</h1>
    <p class="tagline">Statistician &middot; ML Researcher</p>

    <p class="bio">
      I work on theoretical statistics and modern machine learning, currently focused on
      conditional independence testing and synthetic relational databases.
    </p>

    <p class="affiliation">
      Department of Statistics<br/>
      Yonsei University
    </p>

    <div class="social-wrap">
      <SocialLinks layout="vertical" />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    /* The grid in BaseLayout positions us; we just style the inside */
  }

  .sidebar-inner {
    position: sticky;
    top: calc(60px + var(--space-5));
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .photo-frame {
    width: 152px;
    height: 152px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-2);
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-bg-soft), var(--color-tag-bg));
    color: var(--color-tag-text);
    font-family: var(--font-serif);
    font-size: 2.6rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .tagline {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
    letter-spacing: 0.01em;
  }

  .bio {
    font-size: 0.88rem;
    color: var(--color-text-soft);
    line-height: 1.55;
    margin: 0;
  }

  .affiliation {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .social-wrap {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  /* Mobile / tablet: sidebar stacks at the top, no longer sticky */
  @media (max-width: 880px) {
    .sidebar-inner {
      position: static;
      top: auto;
      align-items: flex-start;
    }
    .photo-frame { width: 96px; height: 96px; }
    .photo-placeholder { font-size: 1.6rem; }
    .name { font-size: 1.35rem; }
  }
</style>
